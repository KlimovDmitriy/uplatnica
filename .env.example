# Production domain, used for canonical, hreflang, sitemap and robots.txt
NUXT_PUBLIC_SITE_URL=https://uplatnica.rs

# Search engine verification (value of the content="" attribute)
NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NUXT_PUBLIC_YANDEX_VERIFICATION=

# Optional privacy-friendly analytics (Plausible or a self-hosted compatible script)
NUXT_PUBLIC_PLAUSIBLE_DOMAIN=
# NUXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# "Support the author" (all optional, read at build time). An empty or invalid method is hidden;
# when no method is visible in a language, that language has no donate button, dialog or text.

# IPS QR to a personal RSD account: account number (18 digits or 3-13-2 with dashes, valid check
# digits) and payee name. Write "\n" in the name to start a second line (e.g. the city).
NUXT_PUBLIC_DONATE_IPS_ACCOUNT=
NUXT_PUBLIC_DONATE_IPS_NAME=

# SEPA transfer in EUR (also an EPC QR code): IBAN with valid check digits, BIC (8 or 11
# characters), payee name; the bank name is optional.
NUXT_PUBLIC_DONATE_SEPA_IBAN=
NUXT_PUBLIC_DONATE_SEPA_BIC=
NUXT_PUBLIC_DONATE_SEPA_NAME=
NUXT_PUBLIC_DONATE_SEPA_BANK=

# Card donations: full https:// links to your Ko-fi page and GitHub Sponsors profile
NUXT_PUBLIC_DONATE_KOFI=
NUXT_PUBLIC_DONATE_GITHUB_SPONSORS=

# Russian-language pages only (cards of Russian banks): full https:// links to your DonatePay and
# DonationAlerts pages. They don't exist on the Serbian and English pages; with only these two set,
# the donate UI shows on /ru/ and is hidden elsewhere.
NUXT_PUBLIC_DONATE_DONATEPAY=
NUXT_PUBLIC_DONATE_DONATIONALERTS=

# Stablecoin addresses, one per network family
# Tron (TRC-20): USDT
NUXT_PUBLIC_DONATE_CRYPTO_TRON=
# TON: USDT
NUXT_PUBLIC_DONATE_CRYPTO_TON=
# Solana (SPL): USDT, USDC
NUXT_PUBLIC_DONATE_CRYPTO_SOLANA=
# One EVM address for Polygon, Base, BNB Smart Chain and Arbitrum One: USDT, USDC
NUXT_PUBLIC_DONATE_CRYPTO_EVM=

# Ads, off by default. Empty = no ad markup, no script, no ads.txt. "adsense" renders two Google
# AdSense slots (below the slip actions and between the content blocks) on every language, loads
# the adsbygoogle script lazily in the browser when the first slot nears the viewport, and writes
# /ads.txt at build time. Needs all three values below; a missing one keeps that slot empty.
# Set up Google's consent message (Privacy & messaging in AdSense) for EEA/UK visitors.
NUXT_PUBLIC_ADS_PROVIDER=
# Publisher id, "ca-pub-" plus digits
NUXT_PUBLIC_ADSENSE_CLIENT=
# Numeric ad unit ids (one display ad unit per slot)
NUXT_PUBLIC_ADSENSE_SLOT_AFTER_SLIP=
NUXT_PUBLIC_ADSENSE_SLOT_CONTENT=

# Contact e-mail on the privacy page (/privatnost); the line is hidden when empty
NUXT_PUBLIC_CONTACT_EMAIL=
