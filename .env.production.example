# Content of the GitHub Environment variable DOTENV in the environment "production" (branch main).
# Written to .env before `npm run generate`. Placeholders only: put the real values into the variable.

# Sub-path of the GitHub Pages site. Remove both lines (or use "/" and the bare domain) once a custom
# domain replaces the sub-path.
NUXT_APP_BASE_URL=/uplatnica/
NUXT_PUBLIC_SITE_URL=https://klimovdmitriy.github.io/uplatnica

NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NUXT_PUBLIC_YANDEX_VERIFICATION=
NUXT_PUBLIC_PLAUSIBLE_DOMAIN=
NUXT_PUBLIC_CONTACT_EMAIL=

# Donate details (see .env.example for the formats). Empty = method hidden.
NUXT_PUBLIC_DONATE_IPS_ACCOUNT=
NUXT_PUBLIC_DONATE_IPS_NAME=
NUXT_PUBLIC_DONATE_SEPA_IBAN=
NUXT_PUBLIC_DONATE_SEPA_BIC=
NUXT_PUBLIC_DONATE_SEPA_NAME=
NUXT_PUBLIC_DONATE_SEPA_BANK=
NUXT_PUBLIC_DONATE_KOFI=
NUXT_PUBLIC_DONATE_GITHUB_SPONSORS=
NUXT_PUBLIC_DONATE_DONATEPAY=
NUXT_PUBLIC_DONATE_DONATIONALERTS=
NUXT_PUBLIC_DONATE_CRYPTO_TRON=
NUXT_PUBLIC_DONATE_CRYPTO_TON=
NUXT_PUBLIC_DONATE_CRYPTO_SOLANA=
NUXT_PUBLIC_DONATE_CRYPTO_EVM=

# Ads stay off here: AdSense needs /ads.txt at the domain root, which a github.io sub-path cannot serve.
NUXT_PUBLIC_ADS_PROVIDER=

# Production is indexed: leave NOINDEX unset.
